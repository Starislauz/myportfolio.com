        <style>
            .contact {
                padding: 50px 20px;
                background: #f8f9fa;
                text-align: center;
            }
            .contact-text {
                font-size: 1.2rem;
                margin-bottom: 20px;
                color: #555;
            }
            .contact {
                padding-top: 50px; /* Adds space inside the section */
                  margin-top: 50px;  /* Adds space outside the section */
}

            .contact-buttons a {
                display: inline-block;
                margin: 10px;
                padding: 12px 20px;
                border-radius: 5px;
                font-size: 1rem;
                color: #fff;
                text-decoration: none;
                transition: 0.3s;
            }
            .btn-whatsapp { background: #25d366; }
            .btn-call { background: #007bff; }
            .btn-email { background: #ff6b6b; }
            .contact-buttons a:hover { opacity: 0.8; }
            
            .social-icons {
                margin-top: 20px;
            }
            .social-icons__link {
                display: inline-block;
                font-size: 1.5rem;
                color: #333;
                margin: 0 10px;
                transition: 0.3s;
            }
            .social-icons__link:hover {
                color: #007bff;
            }
        </style>
        
        <!-- FontAwesome Icons -->
